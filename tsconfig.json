{
  "extends": "@reglyph/tsconfig/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
  },
  "include": ["src"]
}
