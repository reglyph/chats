{
  "name": "@reglyph/chats",
  "version": "0.0.2",
  "description": "Reglyph Chats UI base styling and components",
  "type": "module",
  "keywords": [
    "component",
    "design-system",
    "reglyph",
    "reglyph-ui",
    "chats",
    "reglyph-chats",
    "react",
    "react-component",
    "ui",
    "uikit",
    "web"
  ],
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "test": "vitest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watchAll",
    "clean": "gulp clean",
    "build": "gulp",
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build -c .storybook -o storybook-static",
    "test-storybook": "test-storybook",
    "lint:js": "eslint",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:styles": "cross-env stylelint '{styles,src}/**/*.scss'",
    "lint:styles:fix": "cross-env npm run lint:styles -- --fix",
    "lint:prettier": "cross-env prettier --check '**/*.md'",
    "lint:prettier:fix": "cross-env prettier --write '**/*.md'",
    "lint": "run-p lint:*",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm pkg delete engines",
    "playwright:install": "playwright install chromium webkit --with-deps",
    "playwright": "playwright test --config=playwright/playwright.config.ts",
    "playwright:update": "npm run playwright -- -u",
    "playwright:clear-cache": "rm -rf ./playwright/.cache",
    "playwright:docker": "./playwright/run-docker-command.sh npm run playwright --",
    "playwright:docker:update": "./playwright/run-docker-command.sh npm run playwright:update --",
    "playwright:docker:clear-cache": "./playwright/run-docker-command.sh clear-cache"
  },
  "dependencies": {
    "@bem-react/classname": "^1.7.0",
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "sass": "^1.97.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint/js": "^9.39.1",
    "@playwright/experimental-ct-react": "^1.57.0",
    "@playwright/test": "^1.57.0",
    "@reglyph/tsconfig": "^1.0.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.11",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "storybook": "^10.1.11",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.14.0",
    "stylelint-use-logical": "^2.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "nano-staged": {
    "*.{css,scss}": [
      "stylelint --fix --quiet"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.{md,mdx}": [
      "prettier --write"
    ]
  }
}
